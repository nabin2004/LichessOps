# Copy to `.env` here or merge into repo root `.env`.
# Feast 0.11.x legacy stack — optional profile `feast`.

FEAST_VERSION=0.11.1

POSTGRES_USER=feast
POSTGRES_PASSWORD=feast
POSTGRES_DB=feast

# Optional — absolute path to GCP service account JSON (for Feast images that mount it)
GCP_SERVICE_ACCOUNT=/dev/null
