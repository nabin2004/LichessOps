# Copy to `.env` here or merge into repo root `.env`.
# Feast OSS feature server stack — optional profile `feast`.

FEAST_VERSION=0.46.0

# Repo path is mounted into the feature server and Jupyter containers.
# Run Compose from the repo root so this relative path resolves correctly.
FEAST_REPO_PATH=./packages/lichess_features/feast_repo

JUPYTER_TOKEN=feast
