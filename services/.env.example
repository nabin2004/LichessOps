# Copy to `.env` in repo root or `services/airflow/.env` as needed — never commit real secrets.

# MinIO (shared object store — profile `core`)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MLflow Postgres (profile `ml`)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# Grafana (profile `monitoring`)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# Great Expectations metadata Postgres (profile `ge`)
GX_POSTGRES_USER=gx_user
GX_POSTGRES_PASSWORD=gx_password
GX_POSTGRES_DB=great_expectations

# Evidently (profile `evidently`)
EVIDENTLY_POSTGRES_DB=evidently
EVIDENTLY_POSTGRES_USER=evidently
EVIDENTLY_POSTGRES_PASSWORD=evidently

# Airflow UID (Linux: match host user — see Airflow compose docs)
AIRFLOW_UID=1000

# Optional: Feast — see services/feast/.env.example
