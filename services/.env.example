# Copy to `.env` in repo root or `services/airflow/.env` as needed — never commit real secrets.

# MinIO (shared object store — profile `core`)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3-compatible endpoint (host: localhost:9000; Docker network: http://minio:9000)
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
LICHESS_STORAGE_BACKEND=minio
LICHESS_RAW_BUCKET=lichess-raw
LICHESS_PROCESSED_BUCKET=lichess-processed
SPARK_MASTER_URL=spark://spark:7077

# MLflow Postgres (profile `ml`)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# MLflow 3.5+ DNS-rebinding protection (profile `ml`; required for Airflow at http://mlflow:5000)
MLFLOW_SERVER_ALLOWED_HOSTS=mlflow:5000,localhost:*,127.0.0.1:*

# Grafana (profile `monitoring`)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# Great Expectations metadata Postgres (profile `ge`)
GX_POSTGRES_USER=gx_user
GX_POSTGRES_PASSWORD=gx_password
GX_POSTGRES_DB=great_expectations

# Evidently (profile `evidently`)
EVIDENTLY_POSTGRES_DB=evidently
EVIDENTLY_POSTGRES_USER=evidently
EVIDENTLY_POSTGRES_PASSWORD=evidently

# Airflow UID (Linux: match host user — see Airflow compose docs)
AIRFLOW_UID=1000

# Slack Incoming Webhook (token only — path after https://hooks.slack.com/services/)
SLACK_WEBHOOK_TOKEN=your-team-id/your-channel-id/your-secret-token

# Optional: Feast — see services/feast/.env.example
